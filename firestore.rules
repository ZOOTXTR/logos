rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profili: yalnızca sahibi okur/yazar.
    // Ekonomi alanları (gems/isPremium/referralCode) oluşturmada yasak, güncellemede değiştirilemez.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !("gems" in request.resource.data)
        && !("isPremium" in request.resource.data)
        && !("currency" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.referralCode == resource.data.referralCode
        && request.resource.data.gems == resource.data.gems
        && request.resource.data.isPremium == resource.data.isPremium;
      allow delete: if false;

      // Ödül kutusu: yalnızca sahibi okuyabilir (yazım yalnızca Admin SDK)
      match /rewards/{rewardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Bulut kaydı: yalnızca sahibi okur/yazar (boyut sınırı)
    match /cloud_saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Skorlar: okuma serbest (auth), yazma yalnızca Cloud Function (Admin SDK)
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Geri bildirim: kimliği doğrulanmış kullanıcı, boyut sınırlı
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000
        && request.resource.data.rating is number
        && request.resource.data.keys().size() <= 5;
      allow read, update, delete: if false;
    }

    // Düellolar: yalnızca katılımcılar güncelleyebilir; boş oyuncu yuvasını
    // yalnızca o boşluğu doldurunca devralabilir (lobi ele geçirmeyi engeller).
    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.player1 == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.player1 ||
        request.auth.uid == resource.data.player2 ||
        (resource.data.player2 == null && request.resource.data.player2 == request.auth.uid)
      );
      allow delete: if false;
    }

    // IAP makbuz kayıtları yalnızca Admin SDK tarafından yazılır
    match /iap_receipts/{receiptId} {
      allow read, write: if false;
    }

    // Referans kayıtları yalnızca Admin SDK tarafından yazılır
    match /referrals/{referralId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Geri kalan her şey varsayılan olarak kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
