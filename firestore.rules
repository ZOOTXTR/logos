rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cloud saves: only the authenticated user can read/write their own save
    match /cloud_saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Scores: anyone authenticated can read, only owner can create their own
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 5000; // Anti-cheat: max reasonable score
      allow update, delete: if false; // Scores are immutable
    }
    
    // Feedback: authenticated users can submit
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    
    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
